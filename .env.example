# StreetRise environment variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git

# Supabase — get these from your project dashboard at supabase.com
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Stripe (for donations) — get from stripe.com/dashboard
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_key_here

# Google Maps geocoding (optional — defaults to OpenStreetMap Nominatim if absent)
VITE_GOOGLE_MAPS_API_KEY=

# App config
VITE_APP_URL=https://app.streetrise.org
VITE_APP_ENV=development
