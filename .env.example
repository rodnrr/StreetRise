# StreetRise environment variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git

# Supabase — get these from your project dashboard at supabase.com
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Stripe (for donations) — get from stripe.com/dashboard
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_key_here

# Google Maps geocoding (optional — defaults to OpenStreetMap Nominatim if absent)
VITE_GOOGLE_MAPS_API_KEY=

# App config
VITE_APP_URL=https://app.streetrise.org
VITE_APP_ENV=development

# Blog publisher Worker (workers/blog-publisher) — optional.
# Set it to the deployed Worker's origin, with no trailing slash, to show the
# "AI Draft" panel on /admin/blog. Leave it empty and the panel stays hidden.
VITE_BLOG_WORKER_URL=

# Supabase service-role key — ONLY for admin scripts (import-seed-candidates.ts,
# work-exchange-agent.ts)
# Get from: Supabase Dashboard → Project Settings → API → service_role
# NEVER prefix with VITE_ — it must never be exposed to the browser bundle
# NEVER commit this value to git
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key — ONLY for the work exchange agent (scripts/work-exchange-agent.ts)
# Get from: console.anthropic.com → API keys
# NEVER prefix with VITE_ — it must never be exposed to the browser bundle
ANTHROPIC_API_KEY=
