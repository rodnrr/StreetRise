    "eslint-plugin-react-refresh": "^0.4.6",
    "postcss": "^8.5.10",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^3.4.3",
    "tsx": "^4.19.4",
    "typescript": "^5.4.5",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^0.21.2",
    "wrangler": "^4.120.0"
