    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.51.3",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.23.0",
    "zod": "^3.23.4",
